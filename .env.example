# Copy this file to .env and fill in ONE of the options. Never commit .env.

# Option A: OpenAI
OPENAI_API_KEY=
MODEL=gpt-4o-mini

# Option B: any OpenAI-compatible API (e.g. Groq), set these as well as OPENAI_API_KEY
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# MODEL=openai/gpt-oss-120b

# Option C: Azure OpenAI (takes priority if AZURE_OPENAI_ENDPOINT is set)
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21
